# Copy to .env and adjust. Defaults suit the local dev database in tools/devdb.
PGHOST=localhost
PGPORT=5433
PGDATABASE=fsa_training
PGUSER=fsa
PGPASSWORD=fsa

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3210,http://127.0.0.1:3210

# Demo mode: username/password sign-in (demo-logins.txt) instead of SSO, and a business clock pinned
# to the prototype's date.
FSA_DEMO_MODE=true
FSA_DEMO_TODAY=2026-09-09

# POPIA keys for identity numbers. Required when DJANGO_DEBUG=false. Generate each with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Losing the encryption key makes stored ID numbers unreadable; keep it in the vault.
FSA_PII_ENCRYPTION_KEY=
FSA_PII_INDEX_KEY=
