# Edge proxy on the FSA droplet (64.227.19.8): public HTTPS for the Training Hub, forwarded over NetBird
# to the Training Hub VM (fsa-training-hub.netbird.cloud, 100.108.126.58) on port 80. Same pattern as cbh.
# certbot --nginx adds the HTTPS listener, the certificate lines and the HTTP -> HTTPS redirect.
server {
    server_name traininghub.fsa-pty.co.za;

    client_max_body_size 10M;

    location / {
        proxy_pass http://100.108.126.58;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";

        proxy_connect_timeout 30s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;
        proxy_buffering       off;
    }

    access_log /var/log/nginx/fsa-training-hub-access.log;
    error_log  /var/log/nginx/fsa-training-hub-error.log;

    listen 80;
    listen [::]:80;
}
